# ========================================================
# IMP NEWS APP - ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================

# NewsData.io API Key (Ideal for regional/Tamil feeds)
# Free signup: https://newsdata.io
NEWSDATA_API_KEY=pub_your_newsdata_api_key_here

# GNews.io API Key (Ideal for English general and tech feeds)
# Free signup: https://gnews.io/dashboard (Copy your 32-character API key)
GNEWS_API_KEY=your_32_character_gnews_api_key_here

# Google Gemini API Key (For Ask Gemini: Summary, Simple English & News Doubts)
# Free signup: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# In-Memory Cache TTL (seconds) to conserve tokens (User Token-Saver)
CACHE_TTL_SECONDS=3600

# Flask Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-imp-news-2026
PORT=5000
